{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": { "@mh/kit": ["src/kit/index.ts"], "*": ["node_modules/@types/*", "node_modules/*"] }
  },
  "include": ["src", "examples/*/slides/**/*.tsx", "../reels/*/slides/**/*.tsx", "../videos/*/slides/**/*.tsx"]
}
